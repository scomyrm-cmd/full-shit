# Server-only. Never use VITE_ prefixes and never commit a real .env file.
GEMINI_API_KEY=
# Set this to a model enabled for your Google AI project.
GEMINI_MODEL=gemini-2.5-flash
# Optional shared demo gate for the current admin/admin demo login (8+ chars).
# This is not production authentication.
CAMPUS_AI_DEMO_CODE=
# Optional: required for real Supabase Auth administrator sessions.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# local-sanitized (demo-code mode) or supabase (verified Supabase admin only)
SCHOOL_DATA_SOURCE=local-sanitized
